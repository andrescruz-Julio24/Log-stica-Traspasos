generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  BLOCKED
  PENDING
  PARTIAL
  READY
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  PREPARING
  DISPATCHED
  IN_TRANSIT
  RECEIVING
  CLOSED
  CANCELLED
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

model Location {
  returnsToLocation CommercialReturn[]
  supplierReceipts SupplierReceipt[]
  unitStocks UnitStock[]
  id      String          @id @default(cuid())
  name    String          @unique
  stocks  Stock[]
  observations InventoryObservation[]
  clientShipmentOrigins ClientShipment[]
  orders  CustomerOrder[]
  origins Transfer[]      @relation("Origin")
  targets Transfer[]      @relation("Destination")
}

model Product {
  weightOrderLines WeightOrderLine[]
  commercialReturns CommercialReturn[]
  measuredTransferLines MeasuredTransferLine[]
  baseUnit InventoryBaseUnit @default(PIEZA)
  externalLabel String?
  supplierLines SupplierReceiptLine[]
  unitStocks UnitStock[]
  variant      String?
  presentation String?
  id           String         @id @default(cuid())
  sku          String         @unique
  name         String
  stocks       Stock[]
  lines        OrderLine[]
  transfers    TransferLine[]
  observations InventoryObservation[]
}

model Stock {
  sourceCheckedAt DateTime?
  id              String    @id @default(cuid())
  productId       String
  locationId      String
  physical        Int       @default(0)
  reserved        Int       @default(0)
  blocked         Int       @default(0)
  version         Int       @default(0)
  product         Product   @relation(fields: [productId], references: [id])
  location        Location  @relation(fields: [locationId], references: [id])
  localCommitments LocalStockCommitment[]

  @@unique([productId, locationId])
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model CustomerOrder {
  scheduleEvents TransferSchedule[]
  weightLines WeightOrderLine[]
  trips Trip[]
  returns CommercialReturn[]
  priority      Priority    @default(NORMAL)
  dueAt         DateTime?
  id            String      @id @default(cuid())
  code          String      @unique
  customer      String
  destinationId String
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  destination   Location    @relation(fields: [destinationId], references: [id])
  lines         OrderLine[]
  clientShipments ClientShipment[]
}

model OrderLine {
  id           String        @id @default(cuid())
  orderId      String
  productId    String
  required     Int
  accepted     Int           @default(0)
  order        CustomerOrder @relation(fields: [orderId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  reservations Reservation[]
  clientShipmentLines ClientShipmentLine[]
  localCommitments LocalStockCommitment[]

  @@unique([orderId, productId])
}

model Transfer {
  scheduleEvents TransferSchedule[]
  trips Trip[]
  measuredLines MeasuredTransferLine[]
  measuredDispatches MeasuredDispatch[]
  closedWithDifferences Boolean        @default(false)
  id                    String         @id @default(cuid())
  code                  String         @unique
  originId              String
  destinationId         String
  status                TransferStatus @default(REQUESTED)
  createdAt             DateTime       @default(now())
  origin                Location       @relation("Origin", fields: [originId], references: [id])
  destination           Location       @relation("Destination", fields: [destinationId], references: [id])
  lines                 TransferLine[]
  dispatches            Dispatch[]
  receipts              Receipt[]
}

model TransferLine {
  picked       Int           @default(0)
  pickVersion  Int           @default(0)
  id           String        @id @default(cuid())
  transferId   String
  productId    String
  requested    Int
  dispatched   Int           @default(0)
  accepted     Int           @default(0)
  transfer     Transfer      @relation(fields: [transferId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  reservations Reservation[]

  @@unique([transferId, productId])
}

model Reservation {
  unfulfilled    Int                  @default(0)
  allocations    DispatchAllocation[]
  id             String               @id @default(cuid())
  stockId        String
  transferLineId String
  orderLineId    String?
  quantity       Int
  released       Int                  @default(0)
  createdAt      DateTime             @default(now())
  transferLine   TransferLine         @relation(fields: [transferLineId], references: [id])
  orderLine      OrderLine?           @relation(fields: [orderLineId], references: [id])
}

model Dispatch {
  tripId String?
  trip Trip? @relation(fields: [tripId], references: [id])
  inspectedAt DateTime?
  custodian   String?
  receipts    Receipt[]
  id          String         @id @default(cuid())
  transferId  String
  createdAt   DateTime       @default(now())
  transfer    Transfer       @relation(fields: [transferId], references: [id])
  lines       DispatchLine[]
}

model DispatchLine {
  allocations DispatchAllocation[]
  id          String               @id @default(cuid())
  dispatchId  String
  productId   String
  quantity    Int
  dispatch    Dispatch             @relation(fields: [dispatchId], references: [id])
}

model Receipt {
  dispatchId String?
  dispatch   Dispatch?     @relation(fields: [dispatchId], references: [id])
  id         String        @id @default(cuid())
  transferId String
  createdAt  DateTime      @default(now())
  transfer   Transfer      @relation(fields: [transferId], references: [id])
  lines      ReceiptLine[]
}

model ReceiptLine {
  applied   Json?
  reversed  Boolean @default(false)
  id        String  @id @default(cuid())
  receiptId String
  productId String
  presented Int
  accepted  Int
  rejected  Int
  receipt   Receipt @relation(fields: [receiptId], references: [id])
}

model DispatchAllocation {
  holds          Incident[]
  id             String       @id @default(cuid())
  dispatchLineId String
  reservationId  String
  quantity       Int
  accepted       Int          @default(0)
  sequence       Int
  dispatchLine   DispatchLine @relation(fields: [dispatchLineId], references: [id])
  reservation    Reservation  @relation(fields: [reservationId], references: [id])

  @@unique([dispatchLineId, sequence])
}

model Incident {
  commercialReturnId String?
  commercialReturn CommercialReturn? @relation(fields: [commercialReturnId], references: [id])
  supplierReceiptId String?
  supplierReceipt SupplierReceipt? @relation(fields: [supplierReceiptId], references: [id])
  supplierInspectionLineId String?
  supplierInspectionLine SupplierInspectionLine? @relation(fields: [supplierInspectionLineId], references: [id])
  allocationId String?
  allocation   DispatchAllocation? @relation(fields: [allocationId], references: [id])
  assignedTo   String?
  disposition  String?
  returnedAt   DateTime?
  blocking     Boolean             @default(true)
  dispatchId   String?
  sku          String?
  quantity     Int?
  custodian    String?
  location     String?
  evidence     String?
  resolution   String?
  id           String              @id @default(cuid())
  transferId   String?
  type         String
  notes        String
  status       IncidentStatus      @default(OPEN)
  createdAt    DateTime            @default(now())

  @@index([allocationId, status])
  @@index([supplierReceiptId, status])
}

model AuditEvent {
  id        String   @id @default(cuid())
  type      String
  entity    String
  entityId  String
  actor     String
  data      Json
  createdAt DateTime @default(now())
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  operation String
  result    Json
  createdAt DateTime @default(now())
}

model ExceptionRequest {
  id        String    @id @default(cuid())
  kind      String
  targetId  String
  payload   Json
  reason    String
  requester String
  approver  String?
  status    String    @default("PENDING")
  decision  String?
  createdAt DateTime  @default(now())
  decidedAt DateTime?
}

enum InventoryObservationSource {
  PAPER
  EXCEL
  DIGITAL
}

enum InventoryObservationMethod {
  COUNT
  WEIGHT
  ESTIMATE
}

enum InventoryObservationStatus {
  REFERENCE
  VERIFIED
}

model InventoryObservation {
  id                    String                     @id @default(cuid())
  productId             String
  locationId            String
  quantity              Decimal                    @db.Decimal(18, 3)
  unit                  String
  source                InventoryObservationSource
  method                InventoryObservationMethod
  status                InventoryObservationStatus @default(REFERENCE)
  reference             String?
  observedAt            DateTime
  recordedAt            DateTime                   @default(now())
  recordedBy            String
  verifiedAt            DateTime?
  verifiedBy            String?
  stockPhysicalSnapshot Int?
  stockMeasuredSnapshot Decimal? @db.Decimal(18, 3)
  stockVersionSnapshot  Int?
  appliedAt             DateTime?
  appliedBy             String?
  appliedReason         String?
  appliedPhysical       Int?
  appliedMeasured       Decimal? @db.Decimal(18, 3)
  product               Product                    @relation(fields: [productId], references: [id])
  location              Location                   @relation(fields: [locationId], references: [id])

  @@index([locationId, recordedAt])
  @@index([productId, recordedAt])
}

model ClientShipment {
  tripId String?
  trip Trip? @relation(fields: [tripId], references: [id])
  id           String               @id @default(cuid())
  orderId      String
  originId     String
  custodian    String
  reference    String?
  dispatchedAt DateTime             @default(now())
  dispatchedBy String
  order        CustomerOrder        @relation(fields: [orderId], references: [id])
  origin       Location             @relation(fields: [originId], references: [id])
  lines        ClientShipmentLine[]
  receptions   ClientReception[]

  @@index([orderId, dispatchedAt])
}

model ClientShipmentLine {
  id         String                @id @default(cuid())
  shipmentId String
  orderLineId String
  quantity   Int
  shipment   ClientShipment        @relation(fields: [shipmentId], references: [id])
  orderLine  OrderLine             @relation(fields: [orderLineId], references: [id])
  received   ClientReceptionLine[]

  @@unique([shipmentId, orderLineId])
}

model ClientReception {
  id           String                @id @default(cuid())
  shipmentId   String
  receiverName String
  observedAt   DateTime
  recordedAt   DateTime              @default(now())
  recordedBy   String
  notes        String?
  evidenceRef  String?
  shipment     ClientShipment        @relation(fields: [shipmentId], references: [id])
  lines        ClientReceptionLine[]

  @@index([shipmentId, recordedAt])
}

model ClientReceptionLine {
  returnCase CommercialReturn?
  id             String              @id @default(cuid())
  receptionId    String
  shipmentLineId String
  accepted       Int
  rejected       Int
  reception      ClientReception     @relation(fields: [receptionId], references: [id])
  shipmentLine   ClientShipmentLine  @relation(fields: [shipmentLineId], references: [id])

  @@unique([receptionId, shipmentLineId])
}

model LocalStockCommitment {
  id          String    @id @default(cuid())
  orderLineId String
  stockId     String
  quantity    Int
  actor       String
  createdAt   DateTime  @default(now())
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])
  stock       Stock     @relation(fields: [stockId], references: [id])

  @@index([orderLineId, createdAt])
}

enum InventoryBaseUnit {
  PIEZA
  KG
  CAJA
}

enum SupplierReceiptStatus {
  OPEN
  PARTIAL
  INSPECTED
}

// El inventario de PIEZA existente permanece en Stock (valores enteros).
// Esta tabla cubre unidades sin conversión aprobada (KG o CAJA).
model UnitStock {
  id String @id @default(cuid())
  productId String
  locationId String
  unit InventoryBaseUnit
  physical Decimal @default(0) @db.Decimal(18, 3)
  reserved Decimal @default(0) @db.Decimal(18, 3)
  blocked Decimal @default(0) @db.Decimal(18, 3)
  version Int @default(0)
  product Product @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@index([locationId, unit])
}

model SupplierReceipt {
  incidents Incident[]
  id String @id @default(cuid())
  supplier String
  reference String?
  destinationId String
  status SupplierReceiptStatus @default(OPEN)
  createdAt DateTime @default(now())
  createdBy String
  destination Location @relation(fields: [destinationId], references: [id])
  lines SupplierReceiptLine[]
  inspections SupplierInspection[]

  @@index([destinationId, createdAt])
}

model SupplierReceiptLine {
  id String @id @default(cuid())
  receiptId String
  productId String
  unit InventoryBaseUnit
  expected Decimal @db.Decimal(18, 3)
  presented Decimal @default(0) @db.Decimal(18, 3)
  accepted Decimal @default(0) @db.Decimal(18, 3)
  blocked Decimal @default(0) @db.Decimal(18, 3)
  receipt SupplierReceipt @relation(fields: [receiptId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  inspectionLines SupplierInspectionLine[]
  returns SupplierBlockedReturn[]

  @@unique([receiptId, productId])
}

model SupplierInspection {
  id String @id @default(cuid())
  receiptId String
  observedAt DateTime
  recordedAt DateTime @default(now())
  inspectedBy String
  notes String?
  evidenceRef String?
  receipt SupplierReceipt @relation(fields: [receiptId], references: [id])
  lines SupplierInspectionLine[]

  @@index([receiptId, recordedAt])
}

model SupplierInspectionLine {
  incidents Incident[]
  id String @id @default(cuid())
  inspectionId String
  receiptLineId String
  presented Decimal @db.Decimal(18, 3)
  accepted Decimal @db.Decimal(18, 3)
  blocked Decimal @db.Decimal(18, 3)
  inspection SupplierInspection @relation(fields: [inspectionId], references: [id])
  receiptLine SupplierReceiptLine @relation(fields: [receiptLineId], references: [id])

  @@unique([inspectionId, receiptLineId])
}

model SupplierBlockedReturn {
  id String @id @default(cuid())
  receiptLineId String
  quantity Decimal @db.Decimal(18, 3)
  reason String
  returnedBy String
  returnedAt DateTime @default(now())
  receiptLine SupplierReceiptLine @relation(fields: [receiptLineId], references: [id])

  @@index([receiptLineId, returnedAt])
}

model MeasuredTransferLine {
  id String @id @default(cuid())
  transferId String
  productId String
  unit InventoryBaseUnit
  requested Decimal @db.Decimal(18,3)
  reserved Decimal @default(0) @db.Decimal(18,3)
  dispatched Decimal @default(0) @db.Decimal(18,3)
  accepted Decimal @default(0) @db.Decimal(18,3)
  blocked Decimal @default(0) @db.Decimal(18,3)
  estimatedPackages Int?
  averageWeightKg Decimal? @db.Decimal(18,3)
  transfer Transfer @relation(fields: [transferId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  dispatches MeasuredDispatch[]

  @@unique([transferId, productId])
}

model MeasuredDispatch {
  tripId String?
  trip Trip? @relation(fields: [tripId], references: [id])
  id String @id @default(cuid())
  transferId String
  lineId String
  quantity Decimal @db.Decimal(18,3)
  custodian String
  dispatchedAt DateTime @default(now())
  dispatchedBy String
  transfer Transfer @relation(fields: [transferId], references: [id])
  line MeasuredTransferLine @relation(fields: [lineId], references: [id])
  receipts MeasuredReceipt[]

  @@index([transferId, dispatchedAt])
}

model MeasuredReceipt {
  id String @id @default(cuid())
  dispatchId String
  presented Decimal @db.Decimal(18,3)
  accepted Decimal @db.Decimal(18,3)
  blocked Decimal @db.Decimal(18,3)
  observedAt DateTime
  receivedAt DateTime @default(now())
  receivedBy String
  notes String?
  evidenceRef String?
  dispatch MeasuredDispatch @relation(fields: [dispatchId], references: [id])

  @@index([dispatchId, receivedAt])
}

enum DriverCategory {
  REGULAR
  SUPPORT
}

enum TripStatus {
  PLANNED
  ACTIVE
  FINISHED
}

enum CommercialReturnStatus {
  AWAITING_RETURN
  INSPECTION_REQUIRED
  RESOLVED
}

model TransferSchedule {
  id String @id @default(cuid())
  transferId String
  orderId String
  departureAt DateTime
  expectedArrivalAt DateTime
  reason String
  recordedBy String
  recordedAt DateTime @default(now())
  transfer Transfer @relation(fields: [transferId], references: [id])
  order CustomerOrder @relation(fields: [orderId], references: [id])

  @@index([transferId, recordedAt])
}

model DriverProfile {
  id String @id @default(cuid())
  fullName String
  category DriverCategory
  enabled Boolean @default(true)
  available Boolean @default(true)
  authorizedBy String
  createdAt DateTime @default(now())
  assignments DriverAssignment[]

  @@index([enabled, available])
}

model Trip {
  id String @id @default(cuid())
  transferId String?
  orderId String?
  plannedDepartureAt DateTime
  plannedArrivalAt DateTime?
  status TripStatus @default(PLANNED)
  startedAt DateTime?
  finishedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  transfer Transfer? @relation(fields: [transferId], references: [id])
  order CustomerOrder? @relation(fields: [orderId], references: [id])
  assignments DriverAssignment[]
  dispatches Dispatch[]
  measuredDispatches MeasuredDispatch[]
  clientShipments ClientShipment[]

  @@index([transferId, createdAt])
  @@index([orderId, createdAt])
}

model DriverAssignment {
  id String @id @default(cuid())
  tripId String
  driverId String
  provisional Boolean @default(false)
  validUntil DateTime?
  reason String
  assignedBy String
  assignedAt DateTime @default(now())
  trip Trip @relation(fields: [tripId], references: [id])
  driver DriverProfile @relation(fields: [driverId], references: [id])

  @@index([tripId, assignedAt])
  @@index([driverId, assignedAt])
}

model WeightOrderLine {
  id String @id @default(cuid())
  orderId String
  productId String
  plannedKg Decimal @db.Decimal(18,3)
  estimatedBoxes Int?
  averageBoxKg Decimal? @db.Decimal(18,3)
  reservedKg Decimal @default(0) @db.Decimal(18,3)
  dispatchedKg Decimal @default(0) @db.Decimal(18,3)
  order CustomerOrder @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  shipments WeightShipment[]

  @@unique([orderId, productId])
}

model WeightShipment {
  id String @id @default(cuid())
  weightLineId String
  nominalKg Decimal @db.Decimal(18,3)
  actualKg Decimal @db.Decimal(18,3)
  differenceKg Decimal @db.Decimal(18,3)
  documentRef String?
  accountingRef String
  custodian String
  dispatchedBy String
  dispatchedAt DateTime @default(now())
  weightLine WeightOrderLine @relation(fields: [weightLineId], references: [id])
  returnCase CommercialReturn?
}

model CommercialReturn {
  id String @id @default(cuid())
  orderId String
  productId String
  returnLocationId String
  clientReceptionLineId String? @unique
  weightShipmentId String? @unique
  unit InventoryBaseUnit
  expected Decimal @db.Decimal(18,3)
  status CommercialReturnStatus @default(AWAITING_RETURN)
  reason String
  registeredBy String
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  order CustomerOrder @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  returnLocation Location @relation(fields: [returnLocationId], references: [id])
  clientReceptionLine ClientReceptionLine? @relation(fields: [clientReceptionLineId], references: [id])
  weightShipment WeightShipment? @relation(fields: [weightShipmentId], references: [id])
  intake ReturnIntake?
  accountingNotice AccountingNotice?
  incidents Incident[]

  @@index([orderId, status])
}

model ReturnIntake {
  id String @id @default(cuid())
  returnId String @unique
  observed Decimal @db.Decimal(18,3)
  conditionNote String
  evidenceRef String?
  observedAt DateTime
  recordedAt DateTime @default(now())
  receivedBy String
  returnCase CommercialReturn @relation(fields: [returnId], references: [id])
}

model AccountingNotice {
  id String @id @default(cuid())
  returnId String @unique
  reference String @unique
  reason String
  requiresReconciliation Boolean @default(false)
  createdAt DateTime @default(now())
  createdBy String
  returnCase CommercialReturn @relation(fields: [returnId], references: [id])
}
