generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  BLOCKED
  PENDING
  PARTIAL
  READY
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  PREPARING
  DISPATCHED
  IN_TRANSIT
  RECEIVING
  CLOSED
  CANCELLED
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

model Location {
  id      String          @id @default(cuid())
  name    String          @unique
  stocks  Stock[]
  observations InventoryObservation[]
  clientShipmentOrigins ClientShipment[]
  orders  CustomerOrder[]
  origins Transfer[]      @relation("Origin")
  targets Transfer[]      @relation("Destination")
}

model Product {
  variant      String?
  presentation String?
  id           String         @id @default(cuid())
  sku          String         @unique
  name         String
  stocks       Stock[]
  lines        OrderLine[]
  transfers    TransferLine[]
  observations InventoryObservation[]
}

model Stock {
  sourceCheckedAt DateTime?
  id              String    @id @default(cuid())
  productId       String
  locationId      String
  physical        Int       @default(0)
  reserved        Int       @default(0)
  blocked         Int       @default(0)
  version         Int       @default(0)
  product         Product   @relation(fields: [productId], references: [id])
  location        Location  @relation(fields: [locationId], references: [id])
  localCommitments LocalStockCommitment[]

  @@unique([productId, locationId])
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model CustomerOrder {
  priority      Priority    @default(NORMAL)
  dueAt         DateTime?
  id            String      @id @default(cuid())
  code          String      @unique
  customer      String
  destinationId String
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  destination   Location    @relation(fields: [destinationId], references: [id])
  lines         OrderLine[]
  clientShipments ClientShipment[]
}

model OrderLine {
  id           String        @id @default(cuid())
  orderId      String
  productId    String
  required     Int
  accepted     Int           @default(0)
  order        CustomerOrder @relation(fields: [orderId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  reservations Reservation[]
  clientShipmentLines ClientShipmentLine[]
  localCommitments LocalStockCommitment[]

  @@unique([orderId, productId])
}

model Transfer {
  closedWithDifferences Boolean        @default(false)
  id                    String         @id @default(cuid())
  code                  String         @unique
  originId              String
  destinationId         String
  status                TransferStatus @default(REQUESTED)
  createdAt             DateTime       @default(now())
  origin                Location       @relation("Origin", fields: [originId], references: [id])
  destination           Location       @relation("Destination", fields: [destinationId], references: [id])
  lines                 TransferLine[]
  dispatches            Dispatch[]
  receipts              Receipt[]
}

model TransferLine {
  picked       Int           @default(0)
  pickVersion  Int           @default(0)
  id           String        @id @default(cuid())
  transferId   String
  productId    String
  requested    Int
  dispatched   Int           @default(0)
  accepted     Int           @default(0)
  transfer     Transfer      @relation(fields: [transferId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  reservations Reservation[]

  @@unique([transferId, productId])
}

model Reservation {
  unfulfilled    Int                  @default(0)
  allocations    DispatchAllocation[]
  id             String               @id @default(cuid())
  stockId        String
  transferLineId String
  orderLineId    String?
  quantity       Int
  released       Int                  @default(0)
  createdAt      DateTime             @default(now())
  transferLine   TransferLine         @relation(fields: [transferLineId], references: [id])
  orderLine      OrderLine?           @relation(fields: [orderLineId], references: [id])
}

model Dispatch {
  inspectedAt DateTime?
  custodian   String?
  receipts    Receipt[]
  id          String         @id @default(cuid())
  transferId  String
  createdAt   DateTime       @default(now())
  transfer    Transfer       @relation(fields: [transferId], references: [id])
  lines       DispatchLine[]
}

model DispatchLine {
  allocations DispatchAllocation[]
  id          String               @id @default(cuid())
  dispatchId  String
  productId   String
  quantity    Int
  dispatch    Dispatch             @relation(fields: [dispatchId], references: [id])
}

model Receipt {
  dispatchId String?
  dispatch   Dispatch?     @relation(fields: [dispatchId], references: [id])
  id         String        @id @default(cuid())
  transferId String
  createdAt  DateTime      @default(now())
  transfer   Transfer      @relation(fields: [transferId], references: [id])
  lines      ReceiptLine[]
}

model ReceiptLine {
  applied   Json?
  reversed  Boolean @default(false)
  id        String  @id @default(cuid())
  receiptId String
  productId String
  presented Int
  accepted  Int
  rejected  Int
  receipt   Receipt @relation(fields: [receiptId], references: [id])
}

model DispatchAllocation {
  holds          Incident[]
  id             String       @id @default(cuid())
  dispatchLineId String
  reservationId  String
  quantity       Int
  accepted       Int          @default(0)
  sequence       Int
  dispatchLine   DispatchLine @relation(fields: [dispatchLineId], references: [id])
  reservation    Reservation  @relation(fields: [reservationId], references: [id])

  @@unique([dispatchLineId, sequence])
}

model Incident {
  allocationId String?
  allocation   DispatchAllocation? @relation(fields: [allocationId], references: [id])
  assignedTo   String?
  disposition  String?
  returnedAt   DateTime?
  blocking     Boolean             @default(true)
  dispatchId   String?
  sku          String?
  quantity     Int?
  custodian    String?
  location     String?
  evidence     String?
  resolution   String?
  id           String              @id @default(cuid())
  transferId   String?
  type         String
  notes        String
  status       IncidentStatus      @default(OPEN)
  createdAt    DateTime            @default(now())

  @@index([allocationId, status])
}

model AuditEvent {
  id        String   @id @default(cuid())
  type      String
  entity    String
  entityId  String
  actor     String
  data      Json
  createdAt DateTime @default(now())
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  operation String
  result    Json
  createdAt DateTime @default(now())
}

model ExceptionRequest {
  id        String    @id @default(cuid())
  kind      String
  targetId  String
  payload   Json
  reason    String
  requester String
  approver  String?
  status    String    @default("PENDING")
  decision  String?
  createdAt DateTime  @default(now())
  decidedAt DateTime?
}

enum InventoryObservationSource {
  PAPER
  EXCEL
  DIGITAL
}

enum InventoryObservationMethod {
  COUNT
  WEIGHT
  ESTIMATE
}

enum InventoryObservationStatus {
  REFERENCE
  VERIFIED
}

model InventoryObservation {
  id                    String                     @id @default(cuid())
  productId             String
  locationId            String
  quantity              Decimal                    @db.Decimal(18, 3)
  unit                  String
  source                InventoryObservationSource
  method                InventoryObservationMethod
  status                InventoryObservationStatus @default(REFERENCE)
  reference             String?
  observedAt            DateTime
  recordedAt            DateTime                   @default(now())
  recordedBy            String
  verifiedAt            DateTime?
  verifiedBy            String?
  stockPhysicalSnapshot Int?
  product               Product                    @relation(fields: [productId], references: [id])
  location              Location                   @relation(fields: [locationId], references: [id])

  @@index([locationId, recordedAt])
  @@index([productId, recordedAt])
}

model ClientShipment {
  id           String               @id @default(cuid())
  orderId      String
  originId     String
  custodian    String
  reference    String?
  dispatchedAt DateTime             @default(now())
  dispatchedBy String
  order        CustomerOrder        @relation(fields: [orderId], references: [id])
  origin       Location             @relation(fields: [originId], references: [id])
  lines        ClientShipmentLine[]
  receptions   ClientReception[]

  @@index([orderId, dispatchedAt])
}

model ClientShipmentLine {
  id         String                @id @default(cuid())
  shipmentId String
  orderLineId String
  quantity   Int
  shipment   ClientShipment        @relation(fields: [shipmentId], references: [id])
  orderLine  OrderLine             @relation(fields: [orderLineId], references: [id])
  received   ClientReceptionLine[]

  @@unique([shipmentId, orderLineId])
}

model ClientReception {
  id           String                @id @default(cuid())
  shipmentId   String
  receiverName String
  observedAt   DateTime
  recordedAt   DateTime              @default(now())
  recordedBy   String
  notes        String?
  evidenceRef  String?
  shipment     ClientShipment        @relation(fields: [shipmentId], references: [id])
  lines        ClientReceptionLine[]

  @@index([shipmentId, recordedAt])
}

model ClientReceptionLine {
  id             String              @id @default(cuid())
  receptionId    String
  shipmentLineId String
  accepted       Int
  rejected       Int
  reception      ClientReception     @relation(fields: [receptionId], references: [id])
  shipmentLine   ClientShipmentLine  @relation(fields: [shipmentLineId], references: [id])

  @@unique([receptionId, shipmentLineId])
}

model LocalStockCommitment {
  id          String    @id @default(cuid())
  orderLineId String
  stockId     String
  quantity    Int
  actor       String
  createdAt   DateTime  @default(now())
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])
  stock       Stock     @relation(fields: [stockId], references: [id])

  @@index([orderLineId, createdAt])
}
